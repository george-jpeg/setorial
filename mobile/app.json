{
  "expo": {
    "name": "Setorial",
    "slug": "setorial",
    "scheme": "setorial",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.scholarsedge.setorial",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Setorial needs access to your microphone for interactive audio questions and voice responses.",
        "NSPhotoLibraryUsageDescription": "Setorial needs access to your photos to allow you to upload and change your profile picture.",
        "NSCameraUsageDescription": "Setorial needs access to your camera to take a photo for your profile picture.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.scholarsedge.setorial",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "com.android.vending.BILLING"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0B0D12"
          },
          "imageWidth": 450
        }
      ],
      "expo-video",
      "expo-localization",
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-status-bar",
      "expo-audio",
      "expo-apple-authentication",
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8b76e847-0383-48d3-a297-e2e9088bb0f6"
      }
    },
    "owner": "scholars-edge"
  }
}
